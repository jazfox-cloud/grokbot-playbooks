---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from './AdSlot.astro';
import AcceptanceChecklist from './AcceptanceChecklist.astro';
import CopyButton from './CopyButton.astro';
import { type Locale, localePath } from '../config/site';
import {
  getAllCases,
  localeContent,
  relatedCases,
  nextCase,
  type CaseEntry,
} from '../lib/cases';

interface Props {
  locale: Locale;
  entry: CaseEntry;
}

const { locale, entry } = Astro.props;
const all = await getAllCases();
const loc = localeContent(entry, locale);
const related = relatedCases(all, entry, 3);
const next = nextCase(all, entry);
const promptId = `prompt-${entry.data.slug}`;
const checklist = (loc.acceptanceChecklist ?? [])
  .map((item) => item.trim())
  .filter((item) => item.length > 0);

const ui =
  locale === 'zh'
    ? {
        why: '为什么有效',
        steps: '工作流步骤',
        prompt: '提示词 / 例行模板',
        checklist: '验收清单',
        reset: '重置',
        copy: '复制',
        copied: '已复制！',
        connectors: '连接器与例行',
        source: '来源帖文',
        open: '打开原帖',
        relatedPosts: '相关帖子',
        related: '相关 Playbook',
        next: '下一篇',
        back: '返回案例库',
      }
    : {
        why: 'Why it works',
        steps: 'Workflow steps',
        prompt: 'Prompt / routine template',
        checklist: 'Acceptance checklist',
        reset: 'Reset',
        copy: 'Copy',
        copied: 'Copied!',
        connectors: 'Connectors & routines',
        source: 'Source post',
        open: 'Open on X',
        relatedPosts: 'Related posts',
        related: 'Related playbooks',
        next: 'Next',
        back: 'Back to library',
      };

const enPath = `/cases/${entry.data.slug}/`;
const zhPath = `/zh/cases/${entry.data.slug}/`;
---

<BaseLayout
  locale={locale}
  title={loc.title}
  description={loc.summary}
  enPath={enPath}
  zhPath={zhPath}
  ogType="article"
>
  <article class="wrap">
    <header class="detail-hero">
      <a href={localePath(locale)}>{ui.back}</a>
      <div class="card__meta" style="margin-top:0.85rem">
        <span class="badge">{loc.category}</span>
        {entry.data.connectors.map((c) => <span class="badge badge--ghost">{c}</span>)}
      </div>
      <h1>{loc.title}</h1>
      <p class="detail-hero__summary">{loc.summary}</p>
    </header>

    <AdSlot locale={locale} />

    <section class="panel">
      <h2>{ui.why}</h2>
      <p>{loc.whyItWorks}</p>
    </section>

    <section class="panel">
      <h2>{ui.steps}</h2>
      <ol class="steps">
        {loc.workflowSteps.map((step) => <li>{step}</li>)}
      </ol>
    </section>

    <section class="panel">
      <h2>{ui.prompt}</h2>
      <div class="prompt">
        <pre id={promptId}>{loc.promptTemplate}</pre>
        <CopyButton label={ui.copy} copiedLabel={ui.copied} targetId={promptId} />
      </div>
    </section>

    {
      checklist.length > 0 && (
        <AcceptanceChecklist
          items={checklist}
          locale={locale}
          slug={entry.data.slug}
          heading={ui.checklist}
          resetLabel={ui.reset}
        />
      )
    }

    <section class="panel">
      <h2>{ui.connectors}</h2>
      <p>{loc.connectorsAndRoutines}</p>
    </section>

    <section class="panel">
      <h2>{ui.source}</h2>
      <div class="source-row">
        <span>
          <strong>{entry.data.source.authorName}</strong>
          {' '}
          <a
            href={entry.data.source.postUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            {entry.data.source.authorHandle}
          </a>
        </span>
        <a href={entry.data.source.postUrl} target="_blank" rel="noopener noreferrer">
          {ui.open} →
        </a>
      </div>
      <blockquote style="margin:1rem 0 0;color:var(--ink-muted);border-left:3px solid var(--line);padding-left:1rem">
        {entry.data.source.excerpt}
      </blockquote>
    </section>{
      entry.data.relatedPosts && entry.data.relatedPosts.length > 0 && (
        <section class="panel">
          <h2>{ui.relatedPosts}</h2>
          <div class="source-row">
            {entry.data.relatedPosts.map((post) => (
              <a href={post.url} target="_blank" rel="noopener noreferrer">
                {post.label[locale]} →
              </a>
            ))}
          </div>
        </section>
      )
    }

    <section>
      <h2 style="font-family:var(--font-display);letter-spacing:-0.02em">{ui.related}</h2>
      <div class="related">
        {
          related.map((r) => {
            const rloc = localeContent(r, locale);
            return (
              <a href={localePath(locale, `cases/${r.data.slug}`)}>
                <span class="badge">{rloc.category}</span>
                <strong style="display:block;margin-top:0.45rem">{rloc.title}</strong>
              </a>
            );
          })
        }
        {
          next && (
            <a href={localePath(locale, `cases/${next.data.slug}`)}>
              <span class="badge badge--ghost">{ui.next}</span>
              <strong style="display:block;margin-top:0.45rem">
                {localeContent(next, locale).title}
              </strong>
            </a>
          )
        }
      </div>
    </section>
  </article>
</BaseLayout>
